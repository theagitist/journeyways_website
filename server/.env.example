# Tiny backend for www.journeyways.ca contact form.
# Copy this to .env (which is gitignored) and fill in real values.
#
# Required for the contact form to actually send mail.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=changeme@example.com
SMTP_PASS=changeme
SMTP_FROM=noreply@journeyways.ca

# Where contact-form submissions are sent.
# If unset, falls back to SMTP_FROM.
CONTACT_EMAIL=changeme@example.com

# Cloudflare Turnstile (anti-bot). Optional but recommended.
# If TURNSTILE_SECRET_KEY is set, the contact form will require a valid token
# from the Turnstile widget on about.html.
# If unset, Turnstile verification is skipped (with a warning logged).
TURNSTILE_SECRET_KEY=

# Optional. Defaults shown.
PORT=1985
NODE_ENV=production
